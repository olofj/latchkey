<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Latchkey</string>
	<key>CFBundleName</key>
	<string>Latchkey</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Latchkey talks directly to your other Tailscale devices on the same network when it can, which is faster than relaying through Tailscale's servers. It still works if you decline, just more slowly.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContentUsageDescription</key>
		<dict>
			<key>NSATSExceptionFirstPartyServiceConnectionUsage</key>
			<dict>
				<key>NSATSExceptionFirstPartyServiceConnectionUsage</key>
				<dict>
					<key>NSATSExceptionUsageContentEncryptedByNetwork</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
