# Test harness artifacts (regenerate with gen-certs.sh)
testing/harness/*.pem
testing/harness/*.key
testing/harness/*.der
testing/harness/*.srl
testing/harness/*.log
*.ndjson

# The aperture-plus fork is its own git repository (branch main; `upstream` is a
# read-only fetch source), not a submodule of this one. It has no remote of its
# own, so it exists only where it was built. See docs/DECISIONS.md.

# Offline harness runtime state (pidfiles, logs, the proxy journal).
testing/harness/.run/
# L2 tsnet harness: its binary, pidfile, log and node state.
testing/tsnet-harness/.run/
# ...and the binary a plain `go build` there leaves beside the sources.
testing/tsnet-harness/tsnet-harness
__pycache__/

# Xcode / build
app/build/
app/.dd/
DerivedData/
*.xcresult
.DS_Store
